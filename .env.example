# 🚀 JOB AUTOMATION SYSTEM - Configuration
# Copy this to .env and fill in your details

# Your Information
YOUR_NAME="Your Full Name"
YOUR_EMAIL="your.email@gmail.com"
YOUR_PHONE="+1-XXX-XXX-XXXX"
LINKEDIN_URL="linkedin.com/in/yourprofile"

# Email Configuration (for sending applications)
EMAIL_ADDRESS="your.email@gmail.com"
EMAIL_PASSWORD="your_gmail_app_password"
GMAIL_USER="your.email@gmail.com"
GMAIL_APP_PASSWORD="your_gmail_app_password"

# AI Configuration (for resume tailoring and cover letters)
OPENAI_API_KEY="your_openai_key_here"
GITHUB_TOKEN="your_github_token_here"

# Job Search Parameters
JOB_TITLES="Software Engineer,Data Scientist,ML Engineer,Full Stack Developer"
LOCATIONS="Remote,San Francisco,New York,Austin,Seattle"
MAX_APPLICATIONS=10

# Optional: Advanced Settings
MIN_SALARY=80000
EXPERIENCE_LEVEL="entry,mid,senior"
COMPANY_SIZE="startup,medium,enterprise"
