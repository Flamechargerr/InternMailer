# 🚀 JOB AUTOMATION SYSTEM - Configuration
# Copy this to .env and fill in your details

# Your Information
YOUR_NAME="Your Full Name"
YOUR_EMAIL="your.email@gmail.com"
YOUR_PHONE="+1-XXX-XXX-XXXX"
YOUR_TITLE="Your Title"
YOUR_LOCATION="City, Country"
LINKEDIN_URL="linkedin.com/in/yourprofile"
GITHUB_URL="github.com/yourhandle"
PORTFOLIO_URL="your-portfolio.com"
CALENDAR_LINK="https://cal.com/your-handle"

# Optional profile file (YAML/JSON)
PROFILE_PATH="data/profile.yaml"

# Resume attachments (comma-separated)
RESUME_PATHS="resumes/resume.pdf,resume.pdf"

# Email Configuration (for sending applications)
EMAIL_ADDRESS="your.email@gmail.com"
EMAIL_PASSWORD="your_gmail_app_password"
GMAIL_USER="your.email@gmail.com"
GMAIL_APP_PASSWORD="your_gmail_app_password"

# AI Configuration (for resume tailoring and cover letters)
OPENAI_API_KEY="your_openai_key_here"
GITHUB_TOKEN="your_github_token_here"
GROQ_MODEL="llama-3.1-8b-instant"
FRONTEND_ORIGIN="http://localhost:5173"

# Job Search Parameters
JOB_TITLES="Software Engineer,Data Scientist,ML Engineer,Full Stack Developer"
LOCATIONS="Remote,San Francisco,New York,Austin,Seattle"
MAX_APPLICATIONS=10

# Automation
AUTO_APPROVE_SENDS=true
EMAIL_SKIP_ACADEMIC=true
EMAIL_STRICT_TEMPLATE=false
DEFAULT_ROLE_TITLE="Software Engineering Intern"
STRICT_TEMPLATE_KEYWORDS_EXTRA=""

# Contact discovery (Hunter/Apollo)
CONTACT_DISCOVERY_ENABLED=true
CONTACT_DISCOVERY_DAILY_CAP=100
CONTACT_ROLE_KEYWORDS="recruiter,talent,people,hr,hiring"
COMPANY_CONTACTS_CSV="data/company_contacts.csv"
CONTACT_DISCOVERY_PROVIDERS="hunter,apollo"
CONTACT_DISCOVERY_STATE_PATH="data/contact_discovery_state.json"
CONTACT_DISCOVERY_OVERRIDES="data/company_domain_overrides.json"
HUNTER_API_KEY=""
APOLLO_API_KEY=""

# Job Discovery / Auto-Apply
JOB_SOURCES_PATH="data/job_sources.yaml"
JOB_DISCOVERY_MAX_RESULTS=500
JOB_DISCOVERY_DAILY_CAP=50
JOB_SCORE_THRESHOLD=0.6
JOB_SEASON_START="2026-05-01"
JOB_SEASON_END="2026-07-31"
JOB_ALLOW_LONG_TERM=true
JOB_TARGET_LOCATIONS="India"
JOB_ALLOW_USA_WITH_VISA=true
JOB_ROLE_KEYWORDS="intern,internship,sde,software engineer,analyst,tech"
JOB_FORTUNE500_CSV="data/fortune500_2019.csv"
PLAYWRIGHT_USER_DATA_DIR="output/playwright/profile"
PLAYWRIGHT_HEADLESS=false

# Resume ingestion
RESUME_PDF_PATH=""

# Optional: Advanced Settings
MIN_SALARY=80000
EXPERIENCE_LEVEL="entry,mid,senior"
COMPANY_SIZE="startup,medium,enterprise"
