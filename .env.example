# 🚀 INTERNMAILING - ENVIRONMENT CONFIGURATION EXAMPLE
# ====================================================
# Copy this file to .env and fill in your actual credentials

# 📧 Gmail Configuration
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
SENDER_EMAIL=your.email@gmail.com
SENDER_PASSWORD=your_gmail_app_password

# 📮 SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
USE_TLS=true

# 🤖 AI Configuration
GITHUB_TOKEN=your_github_token_here
LLAMA_PROVIDER=github
LLAMA_API_KEY=your_llama_api_key_here
LLAMA_MODEL=gpt-4o-mini
GITHUB_API_BASE=https://models.inference.ai.azure.com

# 🧠 OpenAI Configuration (optional)
# OPENAI_API_KEY=your_openai_api_key_here

# ⚡ Performance Settings
MAX_CONCURRENT_EMAILS=5
RATE_LIMIT_DELAY=2
BATCH_SIZE=50
MAX_EMAILS_PER_DAY=500

# 🛡️ Security & Compliance
ENABLE_BOUNCE_PROTECTION=true
ENABLE_SPAM_FILTERING=true
RESPECT_UNSUBSCRIBE=true
GDPR_COMPLIANT=true

# 📈 Analytics
ENABLE_ANALYTICS=true
LOG_LEVEL=INFO
SAVE_EMAIL_LOGS=true
