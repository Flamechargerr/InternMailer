# Gmail Configuration for InternMailer
# You need to set up Gmail App Passwords: https://support.google.com/accounts/answer/185833

# Your Gmail address
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate this from: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-app-password-here

# Optional: Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:latest

# Optional: Rate limiting (emails per hour)
EMAIL_RATE_LIMIT=50

# Optional: Testing mode (set to true to skip actual email sending)
TEST_MODE=false
