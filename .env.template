# Gmail Configuration for InternMailer
# You need to set up Gmail App Passwords: https://support.google.com/accounts/answer/185833

# Your Gmail address
GMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate this from: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-app-password-here

# Llama API Configuration (Fallback for Azure AI)
# Choose provider: replicate, together, or huggingface
LLAMA_PROVIDER=replicate
LLAMA_API_KEY=your_llama_api_key_here
LLAMA_MODEL=meta/llama-2-70b-chat

# Optional: Rate limiting (emails per hour)
EMAIL_RATE_LIMIT=50

# Test Mode Configuration
# Set to true to send all emails to test address instead of professors
TEST_MODE=false
TEST_EMAIL=your-test-email@gmail.com
