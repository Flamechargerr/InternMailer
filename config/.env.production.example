# ============================================================
# InternMailer - Production Configuration
# ============================================================
# Copy this file to .env and fill in your details
# Never commit .env to version control

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------
# Options: development, staging, production, test
ENVIRONMENT=development

# ------------------------------------------------------------
# Flask Configuration
# ------------------------------------------------------------
# Secret key for session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-generate-random-32-char-string

# Flask host (0.0.0.0 for all interfaces)
FLASK_HOST=0.0.0.0

# Flask port
FLASK_PORT=5050

# ------------------------------------------------------------
# Email Configuration (Required)
# ------------------------------------------------------------
# Gmail address
GMAIL_USER=your.email@gmail.com

# Gmail App Password (generate at https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Alternate email configuration
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

# SMTP Server
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# SMTP Connection Pool Size
SMTP_POOL_SIZE=5

# ------------------------------------------------------------
# Email Limits
# ------------------------------------------------------------
# Maximum emails per day
MAX_EMAILS_PER_DAY=500

# Maximum concurrent emails
MAX_CONCURRENT_EMAILS=10

# Delay between emails (seconds)
RATE_LIMIT_DELAY=0.1

# ------------------------------------------------------------
# AI Configuration (Optional)
# ------------------------------------------------------------
# Groq API Key (Free tier available at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
FRONTEND_ORIGIN=http://localhost:5173

# OpenRouter API Key (Free models available)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub Token (for GitHub Models)
GITHUB_TOKEN=your_github_token_here

# OpenAI API Key (Optional, for advanced features)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------
# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# Requests per hour per IP
RATE_LIMIT_PER_HOUR=1000

# Requests per day per IP
RATE_LIMIT_PER_DAY=10000

# Rate limiting algorithm: sliding or token_bucket
RATE_LIMIT_TYPE=sliding

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Enable CSRF protection
CSRF_ENABLED=true

# Secure cookies (HTTPS required)
SESSION_SECURE=false

# HTTP-only cookies (prevents XSS)
SESSION_HTTPONLY=true

# SameSite cookie policy: Lax, Strict, None
SESSION_SAMESITE=Lax

# ------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------
# Email tracking database path
DATABASE_PATH=campaign_results/email_tracking.db

# Inbox monitor database path
INBOX_DB_PATH=campaign_results/inbox_monitor.db

# Daemon status database path
DAEMON_DB_PATH=campaign_results/daemon_status.db

# ------------------------------------------------------------
# Backup Configuration
# ------------------------------------------------------------
# Backup directory
BACKUP_DIR=backups

# Backup interval (hours)
BACKUP_INTERVAL_HOURS=24

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Enable backup compression
BACKUP_COMPRESSION=true

# ------------------------------------------------------------
# Daemon Configuration
# ------------------------------------------------------------
# Daemon interval (minutes)
DAEMON_INTERVAL_MINUTES=60

# Emails to send per daemon cycle
DAEMON_SEND_PER_CYCLE=0

# Follow-up delay (days)
FOLLOWUP_DELAY_DAYS=7

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory
LOG_DIR=logs

# Maximum log file size (MB)
LOG_MAX_SIZE_MB=10

# Number of log backups to keep
LOG_BACKUP_COUNT=5

# ------------------------------------------------------------
# Health Check
# ------------------------------------------------------------
# Enable health checks
HEALTH_CHECK_ENABLED=true

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL_SECONDS=30

# ------------------------------------------------------------
# Your Information
# ------------------------------------------------------------
YOUR_NAME="Your Full Name"
YOUR_EMAIL="your.email@gmail.com"
YOUR_PHONE="+1-XXX-XXX-XXXX"
YOUR_TITLE="Your Title"
YOUR_LOCATION="City, Country"
LINKEDIN_URL="linkedin.com/in/yourprofile"
GITHUB_URL="github.com/yourhandle"
PORTFOLIO_URL="your-portfolio.com"
CALENDAR_LINK="https://cal.com/your-handle"

# Optional profile file (YAML/JSON)
PROFILE_PATH="data/profile.yaml"

# Resume attachments (comma-separated)
RESUME_PATHS="resumes/resume.pdf,resume.pdf"

# Auto-approve sending (no prompts)
AUTO_APPROVE_SENDS=true
EMAIL_SKIP_ACADEMIC=true
EMAIL_STRICT_TEMPLATE=false
DEFAULT_ROLE_TITLE="Software Engineering Intern"
STRICT_TEMPLATE_KEYWORDS_EXTRA=""

# Contact discovery (Hunter/Apollo)
CONTACT_DISCOVERY_ENABLED=true
CONTACT_DISCOVERY_DAILY_CAP=100
CONTACT_ROLE_KEYWORDS="recruiter,talent,people,hr,hiring"
COMPANY_CONTACTS_CSV="data/company_contacts.csv"
CONTACT_DISCOVERY_PROVIDERS="hunter,apollo"
CONTACT_DISCOVERY_STATE_PATH="data/contact_discovery_state.json"
CONTACT_DISCOVERY_OVERRIDES="data/company_domain_overrides.json"
HUNTER_API_KEY=""
APOLLO_API_KEY=""

# ------------------------------------------------------------
# Job Discovery / Auto-Apply
# ------------------------------------------------------------
JOB_SOURCES_PATH="data/job_sources.yaml"
JOB_DISCOVERY_MAX_RESULTS=500
JOB_DISCOVERY_DAILY_CAP=50
JOB_SCORE_THRESHOLD=0.6
JOB_SEASON_START="2026-05-01"
JOB_SEASON_END="2026-07-31"
JOB_ALLOW_LONG_TERM=true
JOB_TARGET_LOCATIONS="India"
JOB_ALLOW_USA_WITH_VISA=true
JOB_ROLE_KEYWORDS="intern,internship,sde,software engineer,analyst,tech"
JOB_FORTUNE500_CSV="data/fortune500_2019.csv"
PLAYWRIGHT_USER_DATA_DIR="output/playwright/profile"
PLAYWRIGHT_HEADLESS=false

# Resume ingestion
RESUME_PDF_PATH=""

# ------------------------------------------------------------
# Optional: Advanced Features
# ------------------------------------------------------------
# Enable TURBO mode (faster email sending)
TURBO_MODE=false

# Minimum confidence score (0-100)
MIN_CONFIDENCE_SCORE=95

# Enable GDPR compliance
GDPR_COMPLIANT=true

# Enable bounce protection
ENABLE_BOUNCE_PROTECTION=true

# Enable spam filtering
ENABLE_SPAM_FILTERING=true

# Enable analytics
ENABLE_ANALYTICS=true

# Enable real-time monitoring
ENABLE_REAL_TIME_MONITORING=true

# ------------------------------------------------------------
# Job Discovery
# ------------------------------------------------------------
JOB_SOURCES_PATH="data/job_sources.yaml"
JOB_DISCOVERY_MAX_RESULTS=500
JOB_DISCOVERY_DAILY_CAP=50
JOB_SCORE_THRESHOLD=0.6
JOB_SEASON_START="2026-05-01"
JOB_SEASON_END="2026-07-31"
JOB_ALLOW_LONG_TERM=true
JOB_TARGET_LOCATIONS="India"
JOB_ALLOW_USA_WITH_VISA=true
JOB_ROLE_KEYWORDS="intern,internship,sde,software engineer,analyst,tech"

# ------------------------------------------------------------
# Playwright
# ------------------------------------------------------------
PLAYWRIGHT_USER_DATA_DIR="output/playwright/profile"
PLAYWRIGHT_HEADLESS=false
