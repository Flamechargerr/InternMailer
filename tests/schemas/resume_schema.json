{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume Parsing Output Schema",
  "description": "Schema for validating parsed resume data output",
  "type": "object",
  "required": ["skills", "projects", "courses", "experience", "summary"],
  "properties": {
    "skills": {
      "type": "array",
      "description": "List of technical skills",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true
    },
    "projects": {
      "type": "array",
      "description": "List of projects",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "courses": {
      "type": "array",
      "description": "List of academic courses",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100
      },
      "maxItems": 10,
      "uniqueItems": true
    },
    "experience": {
      "type": "array",
      "description": "List of work experience",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 200
      },
      "maxItems": 5,
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "description": "Professional summary",
      "minLength": 10,
      "maxLength": 500
    },
    "domains": {
      "type": "array",
      "description": "Technical domains/specializations",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 50
      },
      "maxItems": 5,
      "uniqueItems": true
    },
    "education": {
      "type": "string",
      "description": "Education information",
      "maxLength": 200
    }
  },
  "additionalProperties": false
}
